 {
  "compilerOptions": {
    "target": "ES2020",

    "module": "Node16",
    "moduleResolution": "node16",

    "rootDir": "src",
    "outDir": "dist",

    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "resolveJsonModule": true
  }
}